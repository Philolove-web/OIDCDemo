{
  "realm": "sso-demo",
  "displayName": "统一身份认证演示",
  "displayNameHtml": "<strong>统一身份认证演示</strong>",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "zh-CN",
    "en"
  ],
  "defaultLocale": "zh-CN",
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "eventsEnabled": true,
  "eventsExpiration": 3600,
  "eventsListeners": [
    "jboss-logging"
  ],
  "adminEventsEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "普通业务用户，可访问系统 1 / 系统 2 的业务接口"
      },
      {
        "name": "admin",
        "description": "管理员，可访问系统 1 / 系统 2 的管理接口"
      }
    ]
  },
  "clients": [
    {
      "clientId": "sso-portal",
      "name": "统一认证前端（门户 / 系统页面）",
      "description": "浏览器端公开客户端；统一门户与系统 1 / 系统 2 的前端页面共用，使用 Authorization Code + PKCE",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "consentRequired": false,
      "rootUrl": "http://localhost:3000",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:3000/",
        "http://localhost:3000/index.html",
        "http://localhost:8081/",
        "http://localhost:8081/index.html",
        "http://localhost:8082/",
        "http://localhost:8082/index.html"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8081",
        "http://localhost:8082"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/##http://localhost:8081/##http://localhost:8082/"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "aud-system1",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "system1",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "aud-system2",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "system2",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "department",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "department",
            "claim.name": "department",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "employeeNo",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "employeeNo",
            "claim.name": "employee_no",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "system1",
      "name": "系统 1 · 订单中心（资源服务）",
      "description": "系统 1 的后端资源服务，使用 JWKS 本地校验 Access Token，不参与浏览器登录",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "system1-demo-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "system2",
      "name": "系统 2 · 消息中心（资源服务）",
      "description": "系统 2 的后端资源服务，使用 JWKS 本地校验 Access Token，不参与浏览器登录",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "system2-demo-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Wang",
      "email": "alice@example.com",
      "attributes": {
        "department": [
          "研发中心"
        ],
        "employeeNo": [
          "E-1001"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "alice123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ],
      "requiredActions": []
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Lee",
      "email": "bob@example.com",
      "attributes": {
        "department": [
          "平台架构部"
        ],
        "employeeNo": [
          "E-0001"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "bob123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user",
        "admin"
      ],
      "requiredActions": []
    }
  ]
}
